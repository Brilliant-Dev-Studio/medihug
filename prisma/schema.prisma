generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  SUPER_ADMIN
  CO_ADMIN
  PARTNER
  PARTNER_MANAGER
  POS_ADMIN
  SUPPORT_ADMIN
  MODERATOR
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  SENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CustomTimeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// User (Patient)
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  password     String
  role         Role      @default(PATIENT)
  gender       Gender?
  birthday     DateTime?
  state        String?
  township     String?
  profileImage String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments        Appointment[]
  doctor              Doctor?
  partnerClinic       Clinic?
  supportConversation SupportConversation?
  favoriteDoctors     FavoriteDoctor[]
  favoriteProducts    FavoriteProduct[]
  customTimeRequests  CustomTimeRequest[]
  orders              Order[]
  clinicReferrals     ClinicReferral[]
  notifications       Notification[]
  deletionRequestsMade     DeletionRequest[] @relation("DeletionRequester")
  deletionRequestsReviewed DeletionRequest[] @relation("DeletionReviewer")
}

// ─────────────────────────────────────────────
// Doctor
// ─────────────────────────────────────────────

model Doctor {
  id             String   @id @default(cuid())
  userId         String?  @unique
  name           String
  nameEn         String?
  specialty      String
  specialtyEn    String?
  bio            String?
  phone          String?
  phoneSecondary String?
  viber          String?
  imageUrl       String?
  coverUrl       String?
  experience     Int      @default(0)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  price          Int      @default(0)
  commissionPercent Int?  // null = inherit PlatformSettings.defaultCommissionPercent
  isAvailable    Boolean  @default(true)
  isActive       Boolean  @default(true)
  isSuggested    Boolean  @default(false)
  allowsCustomTimeRequests Boolean @default(true)
  qualifications String?
  careerMm       String?
  careerEn       String?
  clinicNote     String?
  clinicNoteEn   String?
  clinicTypesMm  String[]
  clinicTypesEn  String[]
  languages      String[]
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User?               @relation(fields: [userId], references: [id])
  appointments       Appointment[]
  referredAppointments Appointment[]     @relation("AppointmentReferralDoctor")
  issuedReferrals    ClinicReferral[]
  clinicDoctors      ClinicDoctor[]
  slots              DoctorSlot[]
  gallery            DoctorGallery[]
  favoritedBy        FavoriteDoctor[]
  blogs              Blog[]
  customTimeRequests CustomTimeRequest[]
  commissionRules    CommissionRule[]
}

// ─────────────────────────────────────────────
// Doctor Gallery
// ─────────────────────────────────────────────

model DoctorGallery {
  id        String   @id @default(cuid())
  doctorId  String
  imageUrl  String
  captionMm String?
  captionEn String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// ─────────────────────────────────────────────
// Doctor Slots (weekly recurring schedule)
// ─────────────────────────────────────────────

model DoctorSlot {
  id         String   @id @default(cuid())
  doctorId   String
  dayOfWeek  Int      // 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
  startTime  String   // "09:00"
  endTime    String   // "12:00"
  duration   Int      @default(30) // minutes per appointment
  maxPerSlot Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// ─────────────────────────────────────────────
// Clinic / Pharmacy (မိတ်ဖက် ဆေးဆိုင် / ဆေးခန်း)
// ─────────────────────────────────────────────

model PartnerType {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String?
  createdAt DateTime @default(now())
}

model Clinic {
  id          String     @id @default(cuid())
  name        String
  nameEn      String?
  type        String     @default("Clinic")
  address     String?
  addressEn   String?
  state       String?
  township    String?
  phone       String?
  phone2      String?
  phone3      String?
  website     String?
  facebookUrl String?
  tiktokUrl   String?
  mapUrl      String?
  imageUrl    String?
  coverUrl    String?
  openTime    String?
  closeTime   String?
  aboutMm     String?
  aboutEn     String?
  tagsMm      String[]
  tagsEn      String[]
  verified    Boolean    @default(false)
  rating      Float      @default(0)
  reviewCount Int        @default(0)
  isActive    Boolean    @default(true)
  isPartner   Boolean    @default(true)
  ownerId     String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner        User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  doctors      ClinicDoctor[]
  appointments Appointment[]
  referredAppointments Appointment[] @relation("AppointmentReferralClinic")
  referrals    ClinicReferral[]
  products     ClinicProduct[]
  gallery      ClinicGallery[]
  branches     ClinicBranch[]
  loginLogs    ClinicLoginLog[]
  commissionRules CommissionRule[]
  revenueEntries  RevenueEntry[]
}

// Shared login account audit trail — a clinic's partner_token login is often used by
// several staff members, so IP/user-agent per login is the only way to distinguish "who".
model ClinicLoginLog {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model ClinicGallery {
  id        String   @id @default(cuid())
  clinicId  String
  imageUrl  String
  captionMm String?
  captionEn String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// A partner clinic can have any number of branches (dynamic — super admin adds/removes
// as many as needed), each with its own title + address.
model ClinicBranch {
  id        String   @id @default(cuid())
  clinicId  String
  title     String
  titleEn   String?
  address   String
  addressEn String?
  mapUrl    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model ClinicDoctor {
  id       String @id @default(cuid())
  clinicId String
  doctorId String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([clinicId, doctorId])
  @@index([doctorId])
}

model ClinicProduct {
  id        String @id @default(cuid())
  clinicId  String
  productId String

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clinicId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Appointment
// ─────────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  userId        String
  doctorId      String
  clinicId      String?
  date          DateTime
  time          String?
  reason        String?
  note          String?
  paymentMethod String?
  fee           Int?    // full patient-paid total (base × sessions, marked up by commission %)
  platformFeeAmount  Int? // platform's cut, snapshotted at booking time
  doctorPayoutAmount Int? // what the doctor receives, snapshotted at booking time
  receiptUrl    String?
  intake        Json?
  aiSummary     String?
  doctorNote    String? // doctor-written clinical note for this consultation, Markdown source
  referredDoctorId String? // referral to another doctor on the platform
  referredClinicId String? // referral to a partner clinic on the platform
  status        AppointmentStatus @default(PENDING)
  doctorApproved Boolean          @default(false)
  callRinging   Boolean           @default(false)
  callDeclined  Boolean           @default(false)
  callActive    Boolean           @default(false) // true while doctor+patient are both actually in the video call — drives the admin "Join" button
  unreadDoctorChat  Boolean   @default(false) // new patient message doctor hasn't seen
  unreadPatientChat Boolean   @default(false) // new doctor message patient hasn't seen
  lastChatMessageAt DateTime?
  cancelReason  String?
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  referredDoctor Doctor? @relation("AppointmentReferralDoctor", fields: [referredDoctorId], references: [id], onDelete: SetNull)
  referredClinic Clinic? @relation("AppointmentReferralClinic", fields: [referredClinicId], references: [id], onDelete: SetNull)
  clinicReferral ClinicReferral?
  messages       AppointmentMessage[]
  refunds        Refund[]
  prescription   Prescription?

  @@index([userId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([referredDoctorId])
  @@index([referredClinicId])
}

// ─────────────────────────────────────────────
// Prescription
// ─────────────────────────────────────────────

model Prescription {
  id                  String              @id @default(cuid())
  appointmentId       String              @unique
  diagnosis           String?
  advice              String?
  referredSpecialist  Boolean             @default(false)
  followUpDate        DateTime?
  followUpTime        String?
  comeAfterDays       Int?
  status              PrescriptionStatus  @default(DRAFT)
  sentAt              DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  appointment Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicines   PrescriptionMedicine[]

  @@index([appointmentId])
}

model PrescriptionMedicine {
  id             String       @id @default(cuid())
  prescriptionId String
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  order          Int          @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ─────────────────────────────────────────────
// Custom Time Request
// ─────────────────────────────────────────────

model CustomTimeRequest {
  id            String                   @id @default(cuid())
  userId        String
  doctorId      String
  requestedDate DateTime
  requestedTime String
  note          String?
  status        CustomTimeRequestStatus  @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([doctorId])
}

// ─────────────────────────────────────────────
// Product
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  description String?
  price       Int      @default(0)
  stock       Int      @default(0)
  imageUrl    String?
  images      String[] @default([])
  category    String?
  brand       String?
  type        String?
  strength    String?
  packSize    String?
  tags        String[]
  keyBenefits String[]
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinics     ClinicProduct[]
  favoritedBy FavoriteProduct[]
  orderItems  OrderItem[]
}

// ─────────────────────────────────────────────
// Orders (product checkout)
// ─────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  receiptUrl    String?
  totalAmount   Int
  note          String?
  cancelReason  String?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  refunds Refund[]

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int // snapshot of product price at order time

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Product Category
// ─────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Specialty
// ─────────────────────────────────────────────

model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Blog Category
// ─────────────────────────────────────────────

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String?
  imageUrl  String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Blog
// ─────────────────────────────────────────────

model Blog {
  id             String    @id @default(cuid())
  title          String
  titleEn        String?
  slug           String    @unique
  content        String
  excerpt        String?
  imageUrl       String?
  category       String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  authorDoctorId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  authorDoctor Doctor? @relation(fields: [authorDoctorId], references: [id], onDelete: SetNull)

  @@index([authorDoctorId])
}

// ─────────────────────────────────────────────
// Favorites
// ─────────────────────────────────────────────

model FavoriteDoctor {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([userId, doctorId])
  @@index([doctorId])
}

model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Special Offers (patient dashboard banner)
// ─────────────────────────────────────────────

model SpecialOffer {
  id        String   @id @default(cuid())
  imageUrl  String
  badgeMm   String
  badgeEn   String?
  titleMm   String
  titleEn   String?
  descMm    String?
  descEn    String?
  ctaMm     String
  ctaEn     String?
  ctaLink   String?
  ctaColor  String   @default("#0d2b6e")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Healthcare Programs (landing page, between Doctors and Products)
// ─────────────────────────────────────────────

model HealthcareProgram {
  id        String   @id @default(cuid())
  imageUrl  String
  titleMm   String
  titleEn   String?
  descMm    String?
  descEn    String?
  ctaLink   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Ads (patient dashboard top slider)
// ─────────────────────────────────────────────

model Ad {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Customer Support Chat (patient ↔ super admin)
// ─────────────────────────────────────────────

model SupportConversation {
  id            String   @id @default(cuid())
  userId        String   @unique
  lastMessageAt DateTime @default(now())
  unreadAdmin   Boolean  @default(false) // new patient message the admin hasn't seen
  unreadPatient Boolean  @default(false) // new admin reply the patient hasn't seen
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
}

enum SupportSender {
  PATIENT
  ADMIN
}

model SupportMessage {
  id             String        @id @default(cuid())
  conversationId String
  sender         SupportSender
  body           String
  createdAt      DateTime      @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─────────────────────────────────────────────
// AI Chat rate limiting (per identifier, per day)
// ─────────────────────────────────────────────

model AiChatUsage {
  id         String @id @default(cuid())
  identifier String // patient: IP address; partner: authenticated user id
  date       String // "YYYY-MM-DD", UTC
  count      Int    @default(0)

  @@unique([identifier, date])
}

// ─────────────────────────────────────────────
// Platform-wide settings (singleton row)
// ─────────────────────────────────────────────

model PlatformSettings {
  id                       String   @id @default("singleton")
  defaultCommissionPercent Int      @default(0)
  updatedAt                DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Clinic referral QR — issued when a doctor refers a patient to a
// partner clinic; the clinic scans/enters the code to verify the
// patient's referral is legit before treating them.
// ─────────────────────────────────────────────

model ClinicReferral {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  clinicId      String
  userId        String
  doctorId      String
  code          String    @unique
  verifiedAt    DateTime?
  verifiedBy    String? // partner user id who scanned/entered the code
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Doctor ↔ patient chat, unlocked once the appointment is CONFIRMED
// ─────────────────────────────────────────────

enum AppointmentMessageSender {
  DOCTOR
  PATIENT
}

model AppointmentMessage {
  id             String                   @id @default(cuid())
  appointmentId  String
  sender         AppointmentMessageSender
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  createdAt      DateTime                 @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// ─────────────────────────────────────────────
// Notification feed (self-hosted, replaces Knock) — the WebSocket layer
// pushes these live; this table is the source of truth for the bell.
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  actionUrl   String?
  actorName   String?
  actorAvatar String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// Deletion requests — POS_ADMIN has no direct delete rights in POS/Finance;
// a delete becomes a request here that SUPER_ADMIN/CO_ADMIN must approve.
// ─────────────────────────────────────────────

model DeletionRequest {
  id          String                 @id @default(cuid())
  entityType  String
  entityId    String
  entityLabel String?
  requestedBy String
  reason      String?
  status      DeletionRequestStatus  @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime               @default(now())

  requester User  @relation("DeletionRequester", fields: [requestedBy], references: [id])
  reviewer  User? @relation("DeletionReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ─────────────────────────────────────────────
// Finance v2 — commission rule engine, payment method fees,
// expense tracking (P&L phase 1)
// ─────────────────────────────────────────────

enum ServiceType {
  CONSULTATION
  PRODUCT
  PROGRAM
  ADS
}

enum ExpenseCategoryType {
  FIXED
  VARIABLE
  ONE_TIME
}

model CommissionRule {
  id            String      @id @default(cuid())
  serviceType   ServiceType
  doctorId      String? // null = applies to all doctors (CONSULTATION only)
  clinicId      String? // null = applies to all clinics
  paymentMethod String? // null = applies to any payment method
  percent       Int         @default(0)
  fixedFee      Int         @default(0) // flat fee on top of percent, e.g. gateway fixed fee
  active        Boolean     @default(true)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([serviceType, doctorId, clinicId, paymentMethod])
}

model PaymentMethodConfig {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  feePercent Int      @default(0)
  feeFixed   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExpenseCategory {
  id        String              @id @default(cuid())
  name      String
  type      ExpenseCategoryType
  createdAt DateTime            @default(now())

  expenses Expense[]
  budgets  Budget[]
}

model Expense {
  id          String   @id @default(cuid())
  categoryId  String
  amount      Int
  description String?
  date        DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([date])
}

// ─────────────────────────────────────────────
// Refund / Cancellation / Adjustment (Finance v2 phase 2)
// ─────────────────────────────────────────────

enum RefundTargetType {
  APPOINTMENT
  ORDER
}

model Refund {
  id            String           @id @default(cuid())
  targetType    RefundTargetType
  appointmentId String?
  orderId       String?
  amount        Int
  reason        String?
  createdBy     String?
  createdAt     DateTime         @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// Reconciliation / Budget (Finance v2 phase 3)
// ─────────────────────────────────────────────

model ReconciliationEntry {
  id            String   @id @default(cuid())
  date          DateTime
  paymentMethod String
  systemAmount  Int
  bankAmount    Int
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, paymentMethod])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  month      String // "YYYY-MM"
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
}

// ─────────────────────────────────────────────
// Program/Ads revenue + audit log (Finance v2 phase 4)
// ─────────────────────────────────────────────

model RevenueEntry {
  id             String      @id @default(cuid())
  serviceType    ServiceType // PROGRAM | ADS
  amount         Int
  description    String?
  clinicId       String?
  platformAmount Int?
  partnerAmount  Int?
  date           DateTime    @default(now())
  createdBy      String?
  createdAt      DateTime    @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([serviceType])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminName  String?
  action     String // 'CREATE' | 'UPDATE' | 'DELETE'
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
